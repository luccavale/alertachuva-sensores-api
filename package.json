{
  "name": "alertachuva-sensores-api",
  "version": "1.0.0",
  "description": "API REST do AlertaChuva (Global Solution FIAP 2026.2 - SOA e Web Services): bairros, sensores, leituras e risco de enchente.",
  "main": "dist/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "jest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/db/seed.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
